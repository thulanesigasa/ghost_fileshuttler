# ==============================================================================
# Ghost_FileShuttler - Environment Configuration Template
# Copy this file to .env and insert your Supabase project keys
# ==============================================================================

# 1. Supabase Project URL
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public Key (anon key)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' 'public'
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Vault Operation Mode
# Options: 'CLOUD' (Global cross-network sync via 4-digit PIN) or 'LAN' (Local network only)
VAULT_MODE=CLOUD

# 4. Flask Session Encryption Secret Key
SECRET_KEY=generate_a_random_secret_key_here

# 5. Local Port (Default: 5000)
PORT=5000
