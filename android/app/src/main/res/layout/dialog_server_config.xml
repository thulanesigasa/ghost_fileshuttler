<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ghost_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_settings"
        android:textColor="@color/ghost_accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Configure local vault host and port for pairing."
        android:textColor="@color/ghost_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Host IP:"
        android:textColor="@color/ghost_text_primary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etHostIp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_tab_bar"
        android:hint="e.g. 10.17.178.160 or 192.168.1.100"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ghost_text_primary"
        android:textColorHint="@color/ghost_text_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Port:"
        android:textColor="@color/ghost_text_primary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_tab_bar"
        android:hint="5000"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ghost_text_primary"
        android:textColorHint="@color/ghost_text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="@color/ghost_text_secondary" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/save"
            android:textColor="@color/ghost_accent"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
