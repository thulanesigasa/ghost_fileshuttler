<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ghost_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connection Settings"
            android:textColor="@color/ghost_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose how your device pairs and syncs across networks."
            android:textColor="@color/ghost_text_secondary"
            android:textSize="12sp" />

        <!-- Mode Radio Group -->
        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbModeCloud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingVertical="4dp"
                android:text="Cloud Vault (Global Sync • No IP Needed)"
                android:textColor="@color/ghost_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbModeLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="Local Area Network (LAN Node)"
                android:textColor="@color/ghost_text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Cloud Configuration Section -->
        <LinearLayout
            android:id="@+id/layoutCloudConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supabase Cloud URL:"
                android:textColor="@color/ghost_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSupabaseUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_tab_bar"
                android:hint="https://your-project.supabase.co"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ghost_text_primary"
                android:textColorHint="@color/ghost_text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Supabase Anon Key:"
                android:textColor="@color/ghost_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSupabaseKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_tab_bar"
                android:hint="eyJhbGciOi..."
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ghost_text_primary"
                android:textColorHint="@color/ghost_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- LAN Configuration Section -->
        <LinearLayout
            android:id="@+id/layoutLanConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Host IP:"
                android:textColor="@color/ghost_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etHostIp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_tab_bar"
                android:hint="e.g. 192.168.1.100"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ghost_text_primary"
                android:textColorHint="@color/ghost_text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Port:"
                android:textColor="@color/ghost_text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_tab_bar"
                android:hint="5000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ghost_text_primary"
                android:textColorHint="@color/ghost_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Dialog Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="@color/ghost_text_secondary" />

            <Button
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save"
                android:textColor="@color/ghost_text_primary"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
