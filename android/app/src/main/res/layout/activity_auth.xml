<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghost_background"
    android:padding="16dp">

    <!-- Card Container (30% Surface Panel per Rule 1) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAuth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:cardBackgroundColor="@color/ghost_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="360dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Brand Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgAuthLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:adjustViewBounds="true"
                    android:background="@null"
                    android:contentDescription="@string/brand_title"
                    android:src="@drawable/ic_vault_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/brand_title"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/auth_subtitle"
                android:textColor="@color/ghost_text_secondary"
                android:textSize="12sp" />

            <!-- 4-Digit PIN Indicator Dots -->
            <LinearLayout
                android:id="@+id/layoutPinDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_pin_dot_empty" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_pin_dot_empty" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_pin_dot_empty" />

                <View
                    android:id="@+id/dot4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_pin_dot_empty" />
            </LinearLayout>

            <!-- Numeric Keypad Grid -->
            <GridLayout
                android:id="@+id/gridKeypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4">

                <!-- 1 -->
                <Button
                    android:id="@+id/btn1"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="1"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 2 -->
                <Button
                    android:id="@+id/btn2"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="2"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 3 -->
                <Button
                    android:id="@+id/btn3"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="3"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 4 -->
                <Button
                    android:id="@+id/btn4"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="4"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 5 -->
                <Button
                    android:id="@+id/btn5"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="5"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 6 -->
                <Button
                    android:id="@+id/btn6"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="6"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 7 -->
                <Button
                    android:id="@+id/btn7"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="7"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 8 -->
                <Button
                    android:id="@+id/btn8"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="8"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- 9 -->
                <Button
                    android:id="@+id/btn9"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="9"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- CLR -->
                <Button
                    android:id="@+id/btnClr"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="CLR"
                    android:textColor="@color/ghost_text_secondary"
                    android:textSize="14sp" />

                <!-- 0 -->
                <Button
                    android:id="@+id/btn0"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:text="0"
                    android:textColor="@color/ghost_text_primary"
                    android:textSize="20sp" />

                <!-- DEL -->
                <ImageButton
                    android:id="@+id/btnDel"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_keypad_button"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/ghost_text_secondary" />
            </GridLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressAuth"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/ghost_accent"
                android:visibility="gone" />

            <!-- Target Server Setting Toggle -->
            <LinearLayout
                android:id="@+id/btnServerConfig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Server"
                    android:src="@drawable/ic_server"
                    app:tint="@color/ghost_text_secondary" />

                <TextView
                    android:id="@+id/tvServerTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Target: http://10.17.178.160:5000"
                    android:textColor="@color/ghost_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
